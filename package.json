{
  "name": "effect-discord-perms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p . --pretty false",
    "test": "vitest run",
    "test:types": "bun --no-env-file scripts/type-tests.ts",
    "hover": "bun --no-env-file scripts/hover.ts",
    "budget": "bun --no-env-file scripts/budget.ts",
    "rules": "bun --no-env-file scripts/rules-check.ts",
    "gen:errors": "bun --no-env-file scripts/gen-errors.ts",
    "verify:offline": "bun --no-env-file scripts/verify-offline.ts",
    "harness:reset": "bun --no-env-file harness/main.ts reset",
    "harness:smoke": "bun --no-env-file harness/main.ts smoke",
    "harness:selftest": "bun --no-env-file harness/main.ts selftest",
    "verify:live": "bun --no-env-file harness/main.ts run --write --compare"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.1.1",
    "dfx": "^1.1.1",
    "discord-api-types": "^0.38.57",
    "effect": "^4.1.1"
  },
  "devDependencies": {
    "@effect/vitest": "^4.1.1",
    "@types/bun": "^1.4.4",
    "typescript": "7.0.2",
    "vitest": "^5"
  }
}
